<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Cursorial.Demo</RootNamespace>
        <CursorialXamlEmbedResources>true</CursorialXamlEmbedResources>
        <!-- The full demo is reflection-heavy (runtime XAML loading, reflective bindings); keep the reflection
             metadata provider available rather than fail-fast. The warnings it produces are expected. -->
        <CursorialXamlReflectionProvider>true</CursorialXamlReflectionProvider>
        <!-- Reflection over the framework types (XAML activation via GetConstructor, brush/color tables,
             binding accessors) needs those types + members PRESERVED. Full trimming removes e.g.
             StackPanel's parameterless ctor (nothing references it statically) → CUR3001 at runtime. Partial
             trim mode keeps non-opted-in assemblies (the Cursorial framework + this demo) whole; only the BCL
             is trimmed. Larger binary, but the reflection-based demo runs. (The trim-clean route is the X4
             generated provider / X5 lowering, not this reflection build.) -->
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.Core\Cursorial.Core.csproj" />
        <ProjectReference Include="..\Cursorial.Rendering\Cursorial.Rendering.csproj" />
        <ProjectReference Include="..\Cursorial.Drawing\Cursorial.Drawing.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Dialogs\Cursorial.UI.Dialogs.csproj" />
        <ProjectReference Include="..\Cursorial.UI\Cursorial.UI.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Bars\Cursorial.UI.Bars.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Xaml.Frontend\Cursorial.UI.Xaml.Frontend.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Xaml\Cursorial.UI.Xaml.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Xaml.Generator\Cursorial.UI.Xaml.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="**/*.png">
            <LogicalName>$([System.String]::new('%(RelativeDir)').Replace('\','/'))%(FileName)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

  <!-- Generator consumer props: the CompilerVisibleItemMetadata + the CursorialXamlEmbedResources default
     (a ProjectReference doesn't auto-import an analyzer's build/ assets, so import them explicitly). -->
  <Import Project="..\Cursorial.UI.Xaml.Generator\build\Cursorial.UI.Xaml.Generator.props" />

  <ItemGroup>
    <ProjectReference Include="..\Cursorial.UI.Xaml\Cursorial.UI.Xaml.csproj" />
    <ProjectReference Include="..\Cursorial.UI\Cursorial.UI.csproj" />
    <!-- The X4 generator as an analyzer (validates the theme XAML; deps flow via its analyzer-deps target). -->
    <ProjectReference Include="..\Cursorial.UI.Xaml.Generator\Cursorial.UI.Xaml.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time validated by the generator; embedded for runtime by the consumer .targets. Manifest
         name stays <RootNamespace>.<dotted path>, e.g. Cursorial.UI.Themes.Xaml.Themes.Controls.xaml. -->
    <CursorialXaml Include="Resources/*.xaml" />
  </ItemGroup>

  <!-- Generator consumer targets: maps <CursorialXaml> → AdditionalFiles (generator input) + EmbeddedResource
       (runtime load). Imported after the items above so @(CursorialXaml) is populated. -->
  <Import Project="..\Cursorial.UI.Xaml.Generator\build\Cursorial.UI.Xaml.Generator.targets" />

  <ItemGroup>
        <RuntimeHostConfigurationOption Include="Cursorial.UI.Xaml.ReflectionMetadataProvider.IsSupported"
                                        Value="$(CursorialXamlReflectionProvider)" Trim="true" />
    </ItemGroup>
</Project>
