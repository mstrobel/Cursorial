<ResourceDictionary xmlns="https://cursorial.dev/ui" xmlns:x="https://cursorial.dev/xaml">

  <!--
    The theme-styles channel (design doc §11.8 #3 / C100), authored declaratively as <ResourceDictionary.Styles>
    — the data twin of CursorialThemeStyles. Consumed only from UIApplication.Theme at Theme(2) (R2/B13, landed):
    selector rules (no x:Key), armed below App so an app style always wins. These layer over BuiltIn's identical
    framework rules (gathered first); authoring them here proves the whole theme-styles channel is data-shippable.
  -->
  <ResourceDictionary.Styles>

    <!-- AccessKeyCue (requirement 6, design doc §7.8/§11.8): the :access-keys pseudo-class binds the ANCESTOR
         scope/window root the AccessKeyManager stamps with InteractionState.AccessKeyCue; every AccessTextPresenter
         underneath flips ShowUnderline (AffectsRender) while the cue is up, underlining the mnemonic. The setter
         owner AccessKeyManager lives in Cursorial.UI.Input — a prefixed Setter owner, resolved via the captured
         `input:` namespace (attached-Setter Phase 2). BuiltIn supplies the identical framework rule; authoring it
         here proves even the Input-namespace owner is fully data-shippable. -->
    <Style Selector=":access-keys AccessTextPresenter">
      <Setter Property="input:AccessKeyManager.ShowUnderline" Value="true"/>
      <!-- <Setter Property="AccessTextPresenter.IndicatorBrush" Value="{DynamicResource {x:Static ThemeKeys.AccessKeyIndicatorBrush}}"/> -->
    </Style>

    <!--
     Theme key assignments for AccessTextPresenter display properties (access key/indicator weight, brush,
     underline style, and reverse-video rendering.
    -->
    <Style Selector="AccessTextPresenter">
      <Setter Property="AccessTextPresenter.IndicatorBrush" Value="{DynamicResource ThemeKeys.AccessKeyIndicatorBrush}" />
      <Setter Property="AccessTextPresenter.KeyInverse" Value="{DynamicResource ThemeKeys.InteractiveCueInverse}" />
      <Setter Property="AccessTextPresenter.KeyUnderline" Value="{DynamicResource ThemeKeys.InteractiveCueUnderline}" />
      <Setter Property="AccessTextPresenter.KeyWeight" Value="{DynamicResource ThemeKeys.InteractiveCueWeight}" />
    </Style>

    <!--
      Active selection brushes for ListBoxItem, TreeViewItem inside a :focus-within parent. 
    -->
    <Style Selector="ListBox:focus-within, TreeView:focus-within">
      <Style.Children>
        <Style Selector="^ :is(ListBoxItem):selected, ^ :is(TreeViewItem):selected">
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.ListItemBackgroundSelected}}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.ListItemForegroundSelected}}" />
        </Style>
        <Style Selector="^ :is(ListBoxItem):focus-visible:selected, ^ :is(TreeViewItem):focus-visible:selected">
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.ListItemBackgroundFocus}}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.ListItemForegroundFocus}}" />
        </Style>
      </Style.Children>
    </Style>

    <!-- caps-unicode glyph opt-up (design doc §12.7 / SD14): under .caps-unicode set the ToggleGlyph.Glyphs
         attached override to colored Unicode marks; a caps-ascii terminal never matches and keeps the ASCII base.
         The glyph triple is the '|'-separated "unchecked|checked|indeterminate" GlyphSetCarrier form. -->
    <Style Selector="CheckBox" RequiresCapabilities="Unicode">
      <Setter Property="ToggleGlyph.Glyphs" Value="[ ]|[✓]|[▪]"/>
    </Style>

    <Style Selector="RadioButton" RequiresCapabilities="Unicode">
      <Setter Property="ToggleGlyph.Glyphs" Value="( )|(●)|(-)"/>
    </Style>

    <!-- caps-nocolor interactive-state layer (design doc §11.8a): colors collapse to Default under NoColor, so the
         button family's focus flip Inverse (reverse-video, honored by the Border fill + content text); the selector
         list spans the ButtonBase family types (CheckBox/RadioButton excluded — in-box caret). Pressed state inverts
         the reverse-video effect.
          -->
    <Style Selector=":is(ButtonBase)" RequiresCapabilities="NoColor">
      <Style.Children>
        <Style Selector="^:focus, ^:pointerover">
          <Setter Property="TextElement.Inverse" Value="True"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="TextElement.Inverse" Value="False"/>
        </Style>
      </Style.Children>
    </Style>

    <!-- caps-nocolor interactive-state layer for input fields (design doc §11.8a): colors collapse to Default under
         NoColor, so the input's family's focus/pressed/default flip Inverse (reverse-video, honored by the Border
         fill + content text); the selector list spans the TextBox hierarchy. -->
    <Style Selector=":is(TextBox), :is(ProgressBar)" RequiresCapabilities="NoColor">
      <Setter Property="TextElement.Inverse" Value="True"/>
    </Style>
    
    <!-- caps-nocolor disabled layer: a disabled button-family control (incl. CheckBox/RadioButton via :is(ButtonBase))
         dims to Faint when its palette would otherwise resolve to Default. -->
    <Style Selector=":is(ButtonBase):disabled" RequiresCapabilities="NoColor">
      <Setter Property="TextElement.TextWeight" Value="Faint"/>
    </Style>

    <!-- Control-level Inverse: the axes are non-inheriting, so this cannot leak into a TabItem's page
         content — the header forwards Inverse to its face + label, the content is untouched. -->
    <Style Selector=":is(ListBoxItem):focus, 
                     :is(ComboBoxItem):selected,
                     :is(ComboBox):focus /template/ #PART_DropDown,
                     :is(ComboBox):open /template/ #PART_DropDown,
                     :is(DatePicker):focus-within /template/ #PART_DropDown,
                     :is(DatePicker):open /template/ #PART_DropDown,
                     :is(MenuItem):selected,
                     :is(MenuItem):highlighted,
                     :is(TabItem):focus" RequiresCapabilities="NoColor">
      <Setter Property="TextElement.Inverse" Value="True"/>
    </Style>

    <!-- TreeViewItem-level Inverse: the axes are non-inheriting. -->
    <Style Selector="TreeViewItem" RequiresCapabilities="NoColor">
      <Style.Children>
        <Style Selector="^:selected">
          <Setter Property="TextElement.TextWeight" Value="Bold"/>
        </Style>
        <Style Selector="^:focus">
          <Setter Property="TextElement.Inverse" Value="True"/>
        </Style>
      </Style.Children>
    </Style>

    <!--:caps-nocolor blink as focus indicator for slider thumb-->
    <Style Selector="Slider:focus /template/ Thumb" RequiresCapabilities="NoColor">
      <Setter Property="TextElement.Blink" Value="True"/>
    </Style>

    <!-- The keyboard focus-row cue for list items (P9.3b — gallery .item.rev): under NoColor the row
         reverse-videos AND bolds; the two setters ride INDEPENDENT axes, composing with the selection
         rule's Inverse (proposal-TextAttributes-decomposition §5 P3 — the composability proof). -->
    <Style Selector=":is(ListBoxItem):focus-visible,
                     :is(ListBoxItem):focus-visible:selected,
                     :is(ComboBoxItem):focus-visible,
                     :is(ComboBoxItem):focus-visible:selected,
                     :is(MenuItem):focus-visible,
                     :is(TabItem):focus-visible" RequiresCapabilities="NoColor">
      <Setter Property="TextElement.Inverse" Value="True"/>
      <Setter Property="TextElement.TextWeight" Value="Bold"/>
    </Style>

    <Style Selector=":is(Border),
                     :is(Panel),
                     :is(UIElement) /template/ :is(Border),
                     :is(Panel) /template/ :is(Panel),
                     .caps-nocolor /template/ :is(Panel)" RequiresCapabilities="NoColor">
      <Setter Property="Border.Occludes" Value="True"/>
      <!-- <Setter Property="Panel.Background" Value="default"/> -->
    </Style>

    <Style Selector=":is(Window), ContextMenu" RequiresCapabilities="NoColor">
      <Setter Property="Control.BorderPen" Value="{DynamicResource {x:Static ThemeKeys.BorderPen}}"/>
    </Style>

    <Style Selector=":is(Border),
                     :is(Panel),
                     :is(UIElement) /template/ :is(Border),
                     :is(Panel) /template/ :is(Panel),
                     .caps-ansi16 /template/ :is(Panel)" RequiresCapabilities="Ansi16">
      <Setter Property="Border.Occludes" Value="True"/>
      <!-- <Setter Property="Panel.Background" Value="default"/> -->
    </Style>

    <Style Selector=":is(Window), ContextMenu" RequiresCapabilities="Ansi16">
      <Setter Property="Control.BorderPen" Value="{DynamicResource {x:Static ThemeKeys.BorderPen}}"/>
    </Style>

    <Style Selector="MenuItem Separator, Menu Separator">
      <Setter Property="Control.BorderPen" Value="{DynamicResource {x:Static ThemeKeys.MenuBorderPen}}"/>
    </Style>

    <Style x:Key="{x:Static ThemeClasses.Accent}" Selector=".accent">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.OnAccentBrush}}"/>
      <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.AccentBrush}}"/>
      <Style.Children>
        <Style Selector="^:is(Button):pointerover, ^:is(Button):focus">
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.Accent2Brush}}"/>
        </Style>
        <Style Selector="^:is(Button):pressed">
          <Setter Property="Panel.Background" Value="#512A46"/>
        </Style>
      </Style.Children>
    </Style>

    <Style x:Key="{x:Static ThemeClasses.Info}" Selector=".info">
      <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.InfoBrush}}"/>
      <Style.Children>
        <Style Selector="^:is(Button):pointerover, ^:is(Button):focus">
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.Info2Brush}}"/>
        </Style>
        <Style Selector="^:is(Button):pressed">
          <Setter Property="Panel.Background" Value="#381ec7"/>
        </Style>
      </Style.Children>
    </Style>

    <Style x:Key="{x:Static ThemeClasses.Cool}" Selector=".cool">
      <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.CoolBrush}}"/>
      <Style.Children>
        <Style Selector="^:is(Button):pointerover, ^:is(Button):focus">
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.Cool2Brush}}"/>
        </Style>
        <Style Selector="^:is(Button):pressed">
          <Setter Property="Panel.Background" Value="#381ec7"/>
        </Style>
      </Style.Children>
    </Style>

    <Style x:Key="{x:Static ThemeClasses.Warning}" Selector=".warning">
      <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.WarningBrush}}"/>
      <Style.Children>
        <Style Selector="^:is(Button):pointerover, ^:is(Button):focus">
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.Warning2Brush}}"/>
        </Style>
        <Style Selector="^:is(Button):pressed">
          <Setter Property="Panel.Background" Value="#381ec7"/>
        </Style>
      </Style.Children>
    </Style>

    <Style x:Key="{x:Static ThemeClasses.Danger}" Selector=".danger">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.DangerBrush}}"/>
      <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}"/>
      <Style.Children>
        <Style Selector="^:is(Button):pointerover, ^:is(Button):focus">
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}"/>
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.Danger2Brush}}"/>
        </Style>
        <Style Selector="^:is(Button):pressed">
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}"/>
          <Setter Property="Panel.Background" Value="#d11f5e"/>
        </Style>
      </Style.Children>
    </Style>

    <Style x:Key="{x:Static ThemeClasses.Success}" Selector=".success">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.SuccessBrush}}"/>
      <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}"/>
      <Style.Children>
        <Style Selector="^:is(Button):pointerover, ^:is(Button):focus">
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}"/>
          <Setter Property="Panel.Background" Value="{DynamicResource {x:Static ThemeKeys.Success2Brush}}"/>
        </Style>
        <Style Selector="^:is(Button):pressed">
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}"/>
          <Setter Property="Panel.Background" Value="#d11f5e"/>
        </Style>
      </Style.Children>
    </Style>

  </ResourceDictionary.Styles>
</ResourceDictionary>
