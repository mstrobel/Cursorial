<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The command-bars suite (design guides docs/ui-layer-design/tokyo-night-bars-design-guide.html et al.) — the
        cell-grid analogue of Actipro's Bars: one shared set of bar controls (BarButton/BarToggleButton/…) surfaced
        as a Toolbar (this phase) and a Ribbon (later), all driven by ICommand. Depends on Cursorial.UI; the bar
        buttons derive from its ButtonBase/ToggleButton. Themes are code-first (Themes/CursorialBarsTheme.cs); a XAML
        twin overlay can follow. No embedded XAML here, so no generator wiring.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet packaging. Shared metadata lives in ../Directory.Build.props; this carries per-package fields only. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Cursorial.UI.Bars</PackageId>
        <Version>0.3.1</Version>
        <Description>Command surfaces for Cursorial.UI — a Toolbar with discrete overflow and a Ribbon (tabs/groups, density collapse, contextual tabs, Backstage, Quick Access Toolbar, minimize), plus KeyTips (Alt-overlay accelerators) and SuperTips, all bound to one shared BarCommand set: define a command once, surface it on any bar.</Description>
        <PackageTags>terminal;tui;ui;toolbar;ribbon;keytips;commands;crossplatform</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.UI\Cursorial.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cursorial.UI.Bars.Tests" />
    </ItemGroup>

</Project>
