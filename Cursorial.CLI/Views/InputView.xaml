<DockPanel xmlns="https://cursorial.dev/ui"
           xmlns:x="https://cursorial.dev/xaml"
           xmlns:d="https://cursorial.dev/xaml/design"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:vm="clr-namespace:Cursorial.CLI.Commandlets;assembly=curio"
           mc:Ignorable="d"
           x:Class="Cursorial.CLI.Views.InputView"
           x:DataType="vm:InputViewModel"
           HorizontalAlignment="Left">
  <d:DataContext>
    <vm:InputViewModel Prompt="Describe your changes:" Lines="4" Placeholder="Write here" />
  </d:DataContext>
  <StackPanel.InputBindings>
    <KeyBinding Gesture="Enter" Command="{Binding AcceptCommand}" />
  </StackPanel.InputBindings>
  <TextBlock DockPanel.Dock="{Binding Lines, Converter={MatchConverter 1, Left, Top}}" Margin="0,0,1,0"
             Text="{Binding Prompt}" HorizontalAlignment="Left" VerticalAlignment="Top" />
  <TextBox x:Name="Editor" Text="{Binding Text, Mode=TwoWay}" Placeholder="{Binding Placeholder}" Width="40"
           MinLines="{Binding Lines}" MaxLines="{Binding Lines}" AcceptsReturn="False"
           VerticalAlignment="Top" HorizontalAlignment="Left" />
</DockPanel>
