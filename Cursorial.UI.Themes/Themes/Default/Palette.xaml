    <ResourceDictionary x:Key="Ansi256">
      <x:String x:Key="{x:Static ThemeKeys.ListItemSelectionGlyph}">▍</x:String>

      <!--  Base / shared — the 3 spec-named aliases whose guide name differs from our role token. -->
      <DynamicResource x:Key="{x:Static ThemeKeys.AccentForegroundBrush}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.SelectionActiveBrush}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.PanelBackgroundBrush}" ResourceKey="{x:Static ThemeKeys.PanelBrush}" />

      <!--  Button (Button / RepeatButton / ToggleButton). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundNormal}" ResourceKey="{x:Static ThemeKeys.SurfaceBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundHover}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundFocus}" ResourceKey="{x:Static ThemeKeys.ElevationRaised}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundPressed}" ResourceKey="{x:Static ThemeKeys.AccentDarkBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundPressed}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledBackgroundBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledForegroundBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.SplitButtonDropZoneBrush}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />

      <!--  ToggleSwitch / CheckBox / RadioButton. -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ToggleForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ToggleGlyphChecked}" ResourceKey="{x:Static ThemeKeys.GreenBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ToggleGlyphIndeterminate}" ResourceKey="{x:Static ThemeKeys.AmberBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.RadioGlyphChecked}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ToggleForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledForegroundBrush}" />

      <!--  Input (TextBox, editable ComboBox). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.InputForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundNormal}" ResourceKey="{x:Static ThemeKeys.SurfaceBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundHover}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnHoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.WellBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputSelectionActive}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputSelectionInactive}" ResourceKey="{x:Static ThemeKeys.SelectionInactiveBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledForegroundBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledBackgroundBrush}" />

      <!--  ListItem (ListBox / ComboBox drop-down item). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundNormal}" ResourceKey="{x:Static ThemeKeys.WellBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundHover}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundSelected}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundSelectedInactive}" ResourceKey="{x:Static ThemeKeys.SelectionInactiveBrush}" />
      <!--  Gallery `.item.rev { background: -text; color: -panel }` (final style guide): a list item sits on the -->
      <!--  PanelBrush surface, so its reverse-video focus ink is -panel (not the universal -bg). #103. -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundFocus}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundSelected}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />

      <!--  TreeViewItem (same item-on-panel reverse-video ink, #103). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemBackgroundSelected}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemForegroundFocus}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
