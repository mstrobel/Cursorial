      <DynamicResource x:Key="{x:Static ThemeKeys.ToggleForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledForegroundBrush}" />

      <!--  Input (TextBox, editable ComboBox). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.InputForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundNormal}" ResourceKey="{x:Static ThemeKeys.SurfaceBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundHover}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnHoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.WellBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputSelectionActive}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputSelectionInactive}" ResourceKey="{x:Static ThemeKeys.SelectionInactiveBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledForegroundBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InputBackgroundDisabled}" ResourceKey="{x:Static ThemeKeys.DisabledBackgroundBrush}" />

      <!--  ListItem (ListBox / ComboBox drop-down item). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundNormal}" ResourceKey="{x:Static ThemeKeys.WellBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnHoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundHover}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundSelected}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundSelectedInactive}" ResourceKey="{x:Static ThemeKeys.SelectionInactiveBrush}" />
      <!--  Gallery `.item.rev { background: -text; color: -panel }` (final style guide): a list item sits on the -->
      <!--  PanelBrush surface, so its reverse-video focus ink is -panel (not the universal -bg). #103. -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundFocus}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundSelected}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />

      <!--  TreeViewItem (same item-on-panel reverse-video ink, #103). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemBackgroundSelected}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemForegroundFocus}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TreeItemForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />

      <!--  Menu (MenuBar / MenuItem / ContextMenu). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuBarBackground}" ResourceKey="{x:Static ThemeKeys.SurfaceBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuBackgroundHover}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuBackgroundHighlighted}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuAcceleratorForeground}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuAcceleratorHoverForeground}" ResourceKey="{x:Static ThemeKeys.TextDimBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.MenuForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />

      <!--  TabItem — gallery: inactive ink = -text-dim, active = -surface fill + -text ink + an -accent -->
      <!--  underline bar (#103, was a -sel fill with -text ink on every tab). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.TabForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextDimBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabForegroundSelected}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnHoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabBackgroundHover}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabForegroundFocused}" ResourceKey="{x:Static ThemeKeys.OnHoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabBackgroundFocused}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabBackgroundSelected}" ResourceKey="{x:Static ThemeKeys.SurfaceBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabControlBorderPen}" ResourceKey="{x:Static ThemeKeys.BorderPen}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabFocusedUnderlinePen}" ResourceKey="{x:Static ThemeKeys.TabUnderlinePen}" />
      <!--  TabUnderlinePen is a Pen (not a brush alias) — defined per-variant in AddTierPalette. -->

      <!--  ProgressBar — gallery: empty track = -faint (#103, was -well). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ProgressFillNormal}" ResourceKey="{x:Static ThemeKeys.GreenBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ProgressFillIndeterminate}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ProgressTrackBrush}" ResourceKey="{x:Static ThemeKeys.FaintBrush}" />

      <!--  Calendar (day cells + Year/Decade cells; DatePicker). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayForeground}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayInactiveForeground}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnHoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayBackgroundHover}" ResourceKey="{x:Static ThemeKeys.HoverBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayTodayForeground}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayBackgroundSelected}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayForegroundSelected}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <!--  Gallery `.cal .focus { background: -text; color: -panel }` (#103, was -bg). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayForegroundFocus}" ResourceKey="{x:Static ThemeKeys.PanelBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayBackgroundFocus}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CalendarDayForegroundDisabled}" ResourceKey="{x:Static ThemeKeys.MutedBrush}" />

      <DynamicResource x:Key="{x:Static ThemeKeys.WindowTitleBarBackground}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.WindowTitleBarActiveBackground}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.WindowTitleBarForeground}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.WindowTitleBarActiveForeground}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />

      <DynamicResource x:Key="{x:Static ThemeKeys.MenuBorderPen}" ResourceKey="{x:Static ThemeKeys.BorderPen}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ToolTipBorderPen}" ResourceKey="{x:Static ThemeKeys.BorderPen}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.TabUnderlinePen}" ResourceKey="{x:Static ThemeKeys.BorderPen}" />

      <DynamicResource x:Key="{x:Static ThemeKeys.Success2Brush}" ResourceKey="{x:Static ThemeKeys.SuccessBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.SuccessDarkBrush}" ResourceKey="{x:Static ThemeKeys.SuccessInverseBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.Danger2Brush}" ResourceKey="{x:Static ThemeKeys.DangerBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.DangerDarkBrush}" ResourceKey="{x:Static ThemeKeys.DangerInverseBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.Cool2Brush}" ResourceKey="{x:Static ThemeKeys.CoolBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.CoolDarkBrush}" ResourceKey="{x:Static ThemeKeys.CoolInverseBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.Warning2Brush}" ResourceKey="{x:Static ThemeKeys.WarningBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.WarningDarkBrush}" ResourceKey="{x:Static ThemeKeys.WarningInverseBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.Info2Brush}" ResourceKey="{x:Static ThemeKeys.InfoBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.InfoDarkBrush}" ResourceKey="{x:Static ThemeKeys.InfoInverseBrush}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
