<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CursorialApp</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cursorial.UI.Xaml" Version="0.3.2" />
        <!-- The XAML source generator: InitializeComponent + typed x:Name fields for x:Class
             views. Its build assets also make every .xaml a <CursorialXaml> item automatically,
             so new views need no csproj edits. -->
        <PackageReference Include="Cursorial.UI.Xaml.Generator" Version="0.3.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- Redundant with the generator's default glob (harmless — the mappings deduplicate),
             but IDE project models only display build actions for items declared in the project
             file itself; this line makes .xaml files read as CursorialXaml instead of None. -->
        <CursorialXaml Include="**/*.xaml" />
    </ItemGroup>

</Project>
