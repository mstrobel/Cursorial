<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet packaging. Shared metadata lives in ../Directory.Build.props; this carries per-package fields only. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Cursorial.Drawing</PackageId>
        <Version>0.5.0</Version>
        <Description>Standard dialog windows for Cursorial.UI — the familiar MessageBox and Windows-style TaskDialog.</Description>
        <PackageTags>terminal;tui;ui;framework;wpf;avalonia;mvvm;controls;databinding;crossplatform;dialogs</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.Animation\Cursorial.Animation.csproj" />
        <ProjectReference Include="..\Cursorial.Rendering\Cursorial.Rendering.csproj" />
        <ProjectReference Include="..\Cursorial.Shared\Cursorial.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cursorial.Drawing.Tests" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Geometry\" />
    </ItemGroup>

</Project>
