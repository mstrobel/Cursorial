<Project Sdk="Microsoft.NET.Sdk">

    <!--
        curio — the Cursorial commandlet suite (docs/cli-design.md). Mirrors Cursorial.Demo.XamlAotStrict's
        strict-AOT gate: full XAML lowering (no runtime loader), PublishAot project-local (do NOT pass
        /p:PublishAot — NETSDK1207 on the ns2.0 generator/frontend), invariant globalization.

            dotnet publish Cursorial.CLI -c Release -r osx-arm64
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Cursorial.CLI</RootNamespace>
        <AssemblyName>curio</AssemblyName>
        <PublishAot>true</PublishAot>
        <CursorialXamlLowering>full</CursorialXamlLowering>
        <CursorialXamlEmbedResources>false</CursorialXamlEmbedResources>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IlcOptimizationPreference>Size</IlcOptimizationPreference>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <Import Project="..\Cursorial.UI.Xaml.Generator\build\Cursorial.UI.Xaml.Generator.props" />

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.UI\Cursorial.UI.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Xaml\Cursorial.UI.Xaml.csproj" />
        <ProjectReference Include="..\Cursorial.UI.Xaml.Generator\Cursorial.UI.Xaml.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <CursorialXaml Include="**/*.xaml" />
    </ItemGroup>

    <Import Project="..\Cursorial.UI.Xaml.Generator\build\Cursorial.UI.Xaml.Generator.targets" />

</Project>
