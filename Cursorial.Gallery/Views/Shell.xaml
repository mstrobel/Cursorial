<DockPanel xmlns="https://cursorial.dev/ui"
           xmlns:x="https://cursorial.dev/xaml"
           xmlns:vm="clr-namespace:Cursorial.Gallery.ViewModels;assembly=Cursorial.Gallery"
           xmlns:i="clr-namespace:Cursorial.Gallery.Infrastructure;assembly=Cursorial.Gallery"
           Background="{DynamicResource {x:Static ThemeKeys.ElevationDesktop}}"
           TextElement.Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}">
    <DockPanel.InputBindings>
      <KeyBinding Gesture="Alt+T" Command="{Binding CycleColorTier}" />
      <KeyBinding Gesture="Alt+D" Command="{Binding CycleThemeVariant}" />
      <KeyBinding Gesture="Alt+Q" Command="{Binding Quit}" />
      <KeyBinding Gesture="Esc"   Command="{Binding Quit}" CommandParameter="True" />
    </DockPanel.InputBindings>

    <!-- Implicit DataTemplates: the ContentControl resolves the selected page view-model's type to its view. -->
    <DockPanel.Resources>

        <DataTemplate DataType="vm:ScrollViewerPageViewModel">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static ThemeKeys.ElevationWindow}}" Padding="1,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding Summary}" />
                        <WrapPanel>
                            <Button Margin="1,0" Content="Cycle V-bar" Command="{Binding CycleVerticalCommand}"/>
                            <Button Margin="1,0" Content="Cycle H-bar" Command="{Binding CycleHorizontalCommand}"/>
                            <Button Margin="1,0" Content="Toggle height" Command="{Binding ToggleHeightCommand}"/>
                            <Button Margin="1,0" Content="Toggle width" Command="{Binding ToggleWidthCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource {x:Static ThemeKeys.ElevationWindow}}" Padding="1,0">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource {x:Static ThemeKeys.TextDimBrush}}"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}"
                              HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}">
                    <ItemsControl ItemsSource="{Binding Rows}" Width="{Binding ContentWidth}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource {x:Static ThemeKeys.MutedBrush}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:InputsPageViewModel">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static ThemeKeys.ElevationWindow}}" Padding="1,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource {x:Static ThemeKeys.TextDimBrush}}"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource {x:Static ThemeKeys.MutedBrush}}"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource {x:Static ThemeKeys.ElevationWindow}}" Padding="1,0">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource {x:Static ThemeKeys.TextDimBrush}}"/>
                </Border>

                <StackPanel Orientation="Vertical" Margin="1,1">
                    <TextBlock Text="Name" Foreground="{DynamicResource {x:Static ThemeKeys.MutedBrush}}"/>
                    <TextBox Width="28" Text="{Binding Name, Mode=TwoWay}"/>

                    <TextBlock Text="Password" Foreground="{DynamicResource {x:Static ThemeKeys.MutedBrush}}"/>
                    <PasswordBox Width="28" Text="{Binding Password, Mode=TwoWay}" RevealPassword="{Binding ShowPassword}"/>
                    <CheckBox Content="Reveal password" IsChecked="{Binding ShowPassword, Mode=TwoWay}"/>

                    <CheckBox Content="Subscribe to updates" IsChecked="{Binding Subscribed, Mode=TwoWay}"/>

                    <TextBlock Text="Volume" Foreground="{DynamicResource {x:Static ThemeKeys.MutedBrush}}"/>
                    <Slider Width="28" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

    </DockPanel.Resources>

    <!-- Title bar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static ThemeKeys.ElevationRaised}}" Padding="1,0">
        <TextBlock Text=" Cursorial — Control Gallery   (Up/Down or click to switch pages · q / Esc to quit)"
                   Foreground="{DynamicResource {x:Static ThemeKeys.TextDimBrush}}"/>
    </Border>

    <!-- Nav: a real ListBox so arrow-key / click navigation is itself part of the showcase -->
    <ListBox DockPanel.Dock="Left" Width="22"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Title}"/>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <!-- Content host: the selected page view-model, resolved to its view by the implicit DataTemplates above.
         ContentControl's default theme is a ContentPresenter that auto-aliases Content and resolves the template. -->
    <ContentControl Content="{Binding SelectedPage}" Margin="1,0"/>

</DockPanel>
