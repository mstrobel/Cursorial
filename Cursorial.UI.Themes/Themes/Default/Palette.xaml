      <SolidColorBrush x:Key="{x:Static ThemeKeys.AnsiCyan}"                       Color="#3f9dbf"/>
      <SolidColorBrush x:Key="{x:Static ThemeKeys.AnsiWhite}"                      Color="#a9b1d6"/>
      <SolidColorBrush x:Key="{x:Static ThemeKeys.AnsiLightBlack}"                 Color="#565f89"/>
