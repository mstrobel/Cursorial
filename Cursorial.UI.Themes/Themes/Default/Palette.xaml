      <DynamicResource x:Key="{x:Static ThemeKeys.SelectionActiveBrush}" ResourceKey="{x:Static ThemeKeys.SelectionBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.PanelBackgroundBrush}" ResourceKey="{x:Static ThemeKeys.PanelBrush}" />

      <!--  Button (Button / RepeatButton / ToggleButton). -->
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundNormal}" ResourceKey="{x:Static ThemeKeys.SurfaceBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundNormal}" ResourceKey="{x:Static ThemeKeys.TextBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonBackgroundHover}" ResourceKey="{x:Static ThemeKeys.AccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ButtonForegroundHover}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
