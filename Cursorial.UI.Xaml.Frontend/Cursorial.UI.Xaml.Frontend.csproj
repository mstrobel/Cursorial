<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The XAML parser frontend. netstandard2.0 deliberately: this assembly is shared
        verbatim with the future X4/X5 source generator (a Roslyn analyzer, which must be
        netstandard2.0). It owns the node model, the XmlReader-driven parser, the
        markup-extension grammar, the diagnostic contract, and the type-system abstractions
        (IXamlTypeMetadataProvider / XamlType / XamlMember / ITypeConverter). It has NO
        reference to Cursorial.UI — the loader (Cursorial.UI.Xaml, net10.0) supplies the
        concrete metadata provider at instantiation time. Pure syntax/grammar/whitespace/
        diagnostic parsing is exercisable with a stub provider and zero framework dependency.
    -->

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <AssemblyName>Cursorial.UI.Xaml.Frontend</AssemblyName>
        <RootNamespace>Cursorial.UI.Xaml</RootNamespace>
    </PropertyGroup>

    <!-- NuGet packaging. netstandard2.0 so the loader AND the Roslyn generator both consume it. Shared metadata
         lives in ../Directory.Build.props; this carries per-package fields only. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Cursorial.UI.Xaml.Frontend</PackageId>
        <Version>0.1.0</Version>
        <Description>The shared XAML parser frontend for Cursorial (netstandard2.0) — the structure-of-arrays node model (XamlDocument), the XmlReader-driven parser, the markup-extension grammar, the diagnostic contract (line+column everywhere), and the type-system abstractions consumed by BOTH the runtime loader (Cursorial.UI.Xaml) and the build-time source generator. No Cursorial.UI dependency.</Description>
        <PackageTags>terminal;tui;xaml;parser;markup;netstandard;crossplatform</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cursorial.UI.Xaml" />
        <InternalsVisibleTo Include="Cursorial.UI.Xaml.Tests" />
        <!-- The X4 generator consumes the node-graph internals (ObjectRecord/MemberRecord/Strings). -->
        <InternalsVisibleTo Include="Cursorial.UI.Xaml.Generator" />
    </ItemGroup>

    <ItemGroup>
        <!-- nullable reference type attributes for netstandard2.0 (MaybeNullWhen, etc.). -->
        <PackageReference Include="System.Memory" Version="4.6.0" />
    </ItemGroup>

</Project>
