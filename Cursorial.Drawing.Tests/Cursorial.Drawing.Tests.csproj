<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Cursorial.Tests.Drawing</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.Drawing\Cursorial.Drawing.csproj" />
    </ItemGroup>

    <!--
        Characterisation baselines are EMBEDDED, not read as loose files. A deterministic CI build
        (DeterministicSourcePaths / ContinuousIntegrationBuild) rewrites [CallerFilePath] to a /_-rooted
        virtual path that isn't on the filesystem, so a disk lookup both misses the committed baseline and
        then faults creating /_ ("Access to the path '/_' is denied"). The embedded copy carries the bytes
        regardless of the source-path mapping; LogicalName keeps the lookup key stable (Baselines/<file>).
    -->
    <ItemGroup>
        <None Remove="Characterisation/Baselines/*.txt" />
        <EmbeddedResource Include="Characterisation/Baselines/*.txt">
            <LogicalName>Baselines/%(FileName)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!--
        MIGRATION SCAFFOLDING (see Characterisation/README-scaffolding.md). The text-pipeline
        characterisation harness slices fragment emissions with the same helper the rendering tests use,
        rather than restating the DECSC…DECRC rule a second time. Remove this link when Characterisation/
        is deleted; the file itself stays where it is (FrameRendererDefaultColorTests uses it).
    -->
    <ItemGroup>
        <Compile Include="..\Cursorial.Rendering.Tests\FragmentEmissionSlicer.cs"
                 Link="Characterisation\FragmentEmissionSlicer.cs" />
    </ItemGroup>

</Project>
