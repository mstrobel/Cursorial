<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The XAML runtime loader. net10.0. References the netstandard2.0 frontend (the parser
        + node model) and Cursorial.UI (the framework types it instantiates). Stage 2
        (instantiation, converter ladder, markup-extension live-attach, resource dictionaries,
        deferred content) lands across X1-X3; X0 ships only the project wiring + the concrete
        reflection metadata provider seam consumed by frontend parse tests.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet packaging. Shared metadata lives in ../Directory.Build.props; this carries per-package fields only. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Cursorial.UI.Xaml</PackageId>
        <Version>0.3.0</Version>
        <Description>The runtime XAML loader for Cursorial.UI — declarative markup with {Binding}/{StaticResource}/{DynamicResource}/{TemplateBinding}, ControlTemplates, ResourceDictionary with merged and theme dictionaries, styles with the full selector grammar, access-key folding, and line+column diagnostics on parse/semantic errors. Pair with Cursorial.UI.Xaml.Generator for build-time validation, code-behind, and AOT.</Description>
        <PackageTags>terminal;tui;xaml;loader;markup;binding;templates;crossplatform</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.UI.Xaml.Frontend\Cursorial.UI.Xaml.Frontend.csproj" />
        <ProjectReference Include="..\Cursorial.UI\Cursorial.UI.csproj" />
        <ProjectReference Include="..\Cursorial.Drawing\Cursorial.Drawing.csproj" />
        <ProjectReference Include="..\Cursorial.Rendering\Cursorial.Rendering.csproj" />
        <ProjectReference Include="..\Cursorial.Core\Cursorial.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cursorial.UI.Xaml.Tests" />
    </ItemGroup>

</Project>
