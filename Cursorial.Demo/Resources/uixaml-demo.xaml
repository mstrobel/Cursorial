<DockPanel xmlns="https://cursorial.dev/ui"
           xmlns:x="https://cursorial.dev/xaml"
           Background="{DynamicResource {x:Static ThemeKeys.SurfaceBrush}}">

    <!-- The whole window is declarative: resources, a control template, themed buttons + toggles, a
         {Binding}-driven status line, access-key mnemonics, and a ScrollViewer — loaded from this one
         embedded .xaml string at runtime by Cursorial.UI.Xaml (the P6 runtime loader). -->

    <DockPanel.Resources>
        <SolidColorBrush x:Key="Chrome"     Color="#1e212c"/>
        <SolidColorBrush x:Key="Accent"     Color="#5678dc"/>
        <SolidColorBrush x:Key="PanelBg"    Color="#262a3a"/>
        <SolidColorBrush x:Key="ButtonFace" Color="#385ca8"/>
        <SolidColorBrush x:Key="ControlInk" Color="#e1e6f5"/>
        <SolidColorBrush x:Key="CaptionInk" Color="#c8cee2"/>

        <!-- A chrome ControlTemplate whose part binds to the templated parent via {TemplateBinding}. -->
        <ControlTemplate x:Key="ChromeTemplate">
            <Border x:Name="PART_Chrome"
                    Background="{TemplateBinding Background}"
                    BorderPen="Light"/>
        </ControlTemplate>
    </DockPanel.Resources>

    <!-- Header band (docked top). -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static ThemeKeys.AccentBrush}}" Height="1">
        <TextBlock Text=" Cursorial.UI — Phase 6: declarative UI loaded from XAML"
                   Foreground="#f0f4ff"/>
    </Border>

    <!-- Status band (docked bottom) — its text is a {Binding} onto the demo view-model. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource {x:Static ThemeKeys.AccentBrush}}" Height="1">
        <TextBlock x:Name="Status" Text="{Binding Status}" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
    </Border>

    <!-- The control panel, inside a scroller (LastChildFill). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Title=" Settings " BorderPen="Light" Padding="1">
            <StackPanel Spacing="1" Margin="1">

                <TextBlock Text="Buttons (Tab focus, Space/Enter or Alt-mnemonic activates):"
                           Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="1,0">
                    <Button x:Name="Ok"     Content="_OK"     Background="{DynamicResource {x:Static ThemeKeys.AccentBrush}}" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                    <Button x:Name="Cancel" Content="_Cancel" Background="{DynamicResource {x:Static ThemeKeys.AccentBrush}}" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                    <Button x:Name="Apply"  Content="_Apply"  Background="{DynamicResource {x:Static ThemeKeys.AccentBrush}}" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                </StackPanel>

                <TextBlock Text="Check boxes (Space / click toggles):"
                           Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                <StackPanel Margin="2,0">
                    <CheckBox x:Name="Airplane" Content=" Airplane mode" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                    <CheckBox x:Name="Wifi"     Content=" Wi-Fi"         Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}" IsChecked="true"/>
                </StackPanel>

                <TextBlock Text="Radio buttons (one group; arrows move + check):"
                           Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                <StackPanel Margin="2,0">
                    <RadioButton x:Name="Low"  Content=" Low"    GroupName="quality" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                    <RadioButton x:Name="Med"  Content=" Medium" GroupName="quality" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}" IsChecked="true"/>
                    <RadioButton x:Name="High" Content=" High"   GroupName="quality" Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                </StackPanel>

                <TextBlock Text="Bound text (the {Binding} on the view-model's Caption):"
                           Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
                <TextBlock x:Name="Live" Text="{Binding Caption}" Foreground="{DynamicResource {x:Static ThemeKeys.AccentBrush}}" Margin="2,0"/>

                <TextBlock Text="Keys: t = cycle color tier · d = flip dark/light · Alt = access keys · q = quit"
                           Foreground="{DynamicResource {x:Static ThemeKeys.TextBrush}}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</DockPanel>
