<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by LibraryImport-generated marshalling stubs (Stdio P/Invoke). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Cursorial</RootNamespace>
    </PropertyGroup>

    <!-- NuGet packaging. Shared metadata (license, authors, repo URL, Source Link, README,
         icon, deterministic-build flags) lives in ../Directory.Build.props; this PropertyGroup
         only carries fields that differ per package. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Cursorial.Core</PackageId>
        <Version>0.3.1</Version>
        <Description>The foundation layer of Cursorial — a cross-platform .NET library for building visually rich terminal applications with first-class mouse and keyboard support. Provides VT/ANSI input parsing, output sequence emission, capability negotiation, and session orchestration over POSIX and Windows stdio.</Description>
        <PackageTags>terminal;tui;vt;ansi;console;input;mouse;keyboard;crossplatform;posix;windows;kitty;sixel</PackageTags>
    </PropertyGroup>

</Project>
