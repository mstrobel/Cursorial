<Project Sdk="Microsoft.NET.Sdk">

    <!--
        ARCH-1: the data-shipped XAML theme (design doc §4.11 — choosing XAML over a fluent C# DSL is what
        makes data-shipped themes possible; the code-first CursorialTheme.BuiltIn stays the always-final
        backstop, §2237). This assembly ships the BuiltIn control themes authored declaratively in XAML,
        loaded at runtime via Cursorial.UI.Xaml and layered over the BuiltIn through UIApplication.Theme.
        Phase 1 ships the Button family; the remaining controls extend the same Themes/*.xaml.

        The theme .xaml are <CursorialXaml> items: the X4 generator validates them at build time (CUR2
        type/member diagnostics at the .xaml line) AND, via the consumer .targets, embeds them as manifest
        resources so CursorialXamlTheme still loads them at runtime through XamlLoader (these are
        ResourceDictionary roots, not x:Class views — code-behind/lowering doesn't apply).
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Full lowering: each Themes/*.xaml (a no-x:Class <ResourceDictionary>) compiles to a reflection-free
             GeneratedXamlLoaders.Build…() builder that CursorialXamlTheme calls — no runtime parse, no provider. -->
        <CursorialXamlLowering>full</CursorialXamlLowering>
        <CursorialXamlEmbedResources>true</CursorialXamlEmbedResources>
        <!-- This is a LIBRARY: don't auto-install the generated provider as the consuming app's process-wide
             default. (With full lowering the provider isn't used at runtime anyway; the .xaml stays embedded
             only as the dual-run drift oracle.) -->
        <CursorialXamlInstallProvider>false</CursorialXamlInstallProvider>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
<!--        <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>-->
    </PropertyGroup>

    <!-- NuGet packaging. Shared metadata lives in ../Directory.Build.props; this carries per-package fields only.
         The generated XAML builders are compiled into the assembly, so the package is a normal library. -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <PackageId>Cursorial.UI.Themes</PackageId>
        <Version>0.3.1</Version>
        <Description>The data-shipped XAML theme overlay for Cursorial.UI — the built-in control themes authored declaratively in XAML (Default and IndigoDusk variants), lowered to reflection-free builders at build time and layered over the code-first backstop through UIApplication.Theme.</Description>
        <PackageTags>terminal;tui;ui;theme;xaml;dark;light;crossplatform</PackageTags>
    </PropertyGroup>

    <!-- Generator consumer props: the CompilerVisibleItemMetadata + the CursorialXamlEmbedResources default
         (a ProjectReference doesn't auto-import an analyzer's build/ assets, so import them explicitly). -->
    <Import Project="..\Cursorial.UI.Xaml.Generator\build\Cursorial.UI.Xaml.Generator.props" />

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.UI.Xaml\Cursorial.UI.Xaml.csproj" />
        <ProjectReference Include="..\Cursorial.UI\Cursorial.UI.csproj" />
        <!-- The X4 generator as an analyzer (validates the theme XAML; deps flow via its analyzer-deps target). -->
        <ProjectReference Include="..\Cursorial.UI.Xaml.Generator\Cursorial.UI.Xaml.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Build-time validated by the generator; embedded for runtime by the consumer .targets. Manifest
             name stays <RootNamespace>.<dotted path>, e.g. Cursorial.UI.Themes.Xaml.Themes.Controls.xaml. -->
        <CursorialXaml Include="Themes\*.xaml" />
        <CursorialXaml Include="Themes\Default\*.xaml" />
        <CursorialXaml Include="Themes\IndigoDusk\*.xaml" />
    </ItemGroup>

    <!-- Generator consumer targets: maps <CursorialXaml> → AdditionalFiles (generator input) + EmbeddedResource
         (runtime load). Imported after the items above so @(CursorialXaml) is populated. -->
    <Import Project="..\Cursorial.UI.Xaml.Generator\build\Cursorial.UI.Xaml.Generator.targets" />

</Project>
