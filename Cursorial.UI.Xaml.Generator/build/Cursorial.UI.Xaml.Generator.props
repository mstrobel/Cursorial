<Project>

    <ItemGroup>
      <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    </ItemGroup>

    <!--
      Cursorial XAML generator — consumer props (WS-X4.2). Imported early (before the consumer's items),
      this exposes the AdditionalFiles `SourceItemType` metadata to the generator so it can filter the
      CursorialXaml inputs out of any other AdditionalFiles. The CursorialXaml → AdditionalFiles mapping
      itself is in the paired .targets (after item evaluation).
    -->

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SourceItemType" />
  </ItemGroup>

  <!--
    Default items: every .xaml under the project root is a <CursorialXaml> — new files start
    life with the right build action, no csproj edit needed (mirrors the SDK's
    EnableDefaultItems pattern). The glob lives HERE (top import) so a consumer's csproj body
    can still <CursorialXaml Remove="..."/> or Update= specific files; the paired .targets
    removes the same files from the SDK's default None items (which do not exist yet at props
    time). Opt out entirely with <EnableDefaultCursorialXamlItems>false</...>; projects keeping
    explicit <CursorialXaml Include> entries should drop them (the AdditionalFiles /
    EmbeddedResource mappings deduplicate, so duplicates are harmless but pointless).
  -->
  <PropertyGroup>
    <EnableDefaultCursorialXamlItems Condition="'$(EnableDefaultCursorialXamlItems)' == ''">true</EnableDefaultCursorialXamlItems>
  </PropertyGroup>

  <!-- The default-items GLOB lives in the paired .targets, not here: the bottom import
       evaluates after the consumer's csproj body, so the glob can self-exclude explicitly
       declared <CursorialXaml> items (declared for IDE build-action display) instead of
       duplicating them — duplicate claims render as duplicate files in the IDE tree. -->

  <!--
    WS-X5.5 — the full-lowering opt-in. Set <CursorialXamlLowering>full</CursorialXamlLowering> to compile each
    x:Class document to straight-line, reflection-free C# (no runtime XAML loader) instead of the default
    loader-backed code-behind. A member the lowering can't yet emit is reported as a CURG3001 build warning.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="CursorialXamlLowering" />
  </ItemGroup>

  <!--
    The generated metadata provider is advertised via [assembly: XamlMetadataProvider] — pull metadata only.
    Generated code-behinds bind it explicitly; the loader's lazy DEFAULT consults the ENTRY assembly's
    attribute only when the reflection provider is disabled for trimming/AOT (with reflection available,
    ambient loads stay open-world reflection), and a library's attribute stays inert (its provider only
    covers the library's own closed type set). Nothing installs at load time, so no opt-out is needed
    (the retired CursorialXamlInstallProvider property is ignored if set).
  -->

  <!--
    A <CursorialXaml> item is ALSO embedded as a manifest resource by default (the paired .targets), so a
    document validated/baked at build time stays loadable at runtime via XamlLoader (ResourceDictionary themes,
    no-x:Class views). A pure compile-time / fully-lowered consumer that never runtime-loads its XAML can set
    <CursorialXamlEmbedResources>false</CursorialXamlEmbedResources> to skip the embed.
  -->
  <PropertyGroup>
    <CursorialXamlEmbedResources Condition="'$(CursorialXamlEmbedResources)' == ''">true</CursorialXamlEmbedResources>
  </PropertyGroup>

  <!--
    WS-X4.7 — strict AOT. The CursorialXamlStrictAot default (PublishAot OR PublishTrimmed) is computed in the
    paired .targets, NOT here: this .props is imported at the TOP of the project (the NuGet build/ convention), so
    reading $(PublishAot) here would miss a consumer that sets <PublishAot>true</PublishAot> later in its csproj
    body. The .targets is imported at the bottom, after the body — so it observes the final value.
  -->

</Project>
