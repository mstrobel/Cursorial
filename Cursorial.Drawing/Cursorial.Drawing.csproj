<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet packaging. Shared metadata lives in ../Directory.Build.props; this carries per-package fields only. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Cursorial.Drawing</PackageId>
        <Version>0.1.0</Version>
        <Description>The retained-scene drawing layer for Cursorial — cached-raster scenes and a compositor that only repaints what changed, brushes and gradients, a pen/box engine with automatic box-drawing junctions, charts, and UI drawing primitives (clip/translate, occluding fills, titled panels, drop/inner shadows). Built on Cursorial.Rendering + Cursorial.Animation.</Description>
        <PackageTags>terminal;tui;drawing;scene;compositor;brush;gradient;charts;crossplatform</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cursorial.Animation\Cursorial.Animation.csproj" />
        <ProjectReference Include="..\Cursorial.Rendering\Cursorial.Rendering.csproj" />
        <ProjectReference Include="..\Cursorial.Shared\Cursorial.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cursorial.Drawing.Tests" />
    </ItemGroup>

</Project>
