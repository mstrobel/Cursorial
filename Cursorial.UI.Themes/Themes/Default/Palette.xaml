      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundFocus}" ResourceKey="{x:Static ThemeKeys.OnAccentBrush}" />
      <DynamicResource x:Key="{x:Static ThemeKeys.ListItemForegroundSelected}" ResourceKey="{x:Static ThemeKeys.SelectionInk}" />
